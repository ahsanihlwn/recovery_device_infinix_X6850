 int GUIAction::enablefastboot(std::string arg __unused) {
 	android::base::SetProperty("sys.usb.config", "none");
-	android::base::SetProperty("sys.usb.config", "fastboot");
-	return 0;
+	const bool fastboot_ready =
+		!android::base::GetBoolProperty("ro.boot.dynamic_partitions", false) ||
+		PartitionManager.Unmap_Super_Devices();
+	if (!fastboot_ready) {
+		LOGERR("Unable to unmap dynamic partitions; keeping ADB active.\n");
+	}
+	android::base::SetProperty("sys.usb.config", fastboot_ready ? "fastboot" : "adb");
+	DataManager::SetValue("tw_enable_fastboot", fastboot_ready ? 1 : 0);
+	DataManager::SetValue("tw_enable_adb", fastboot_ready ? 0 : 1);
+	return fastboot_ready ? 0 : 1;
 }
 
 
