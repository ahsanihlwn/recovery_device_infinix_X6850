+// Only confirmed Format Data may remove the metadata-encryption mapping.
+// A normal (non-forced, non-deferred) remove fails while any mount or fd uses it.
+static bool Remove_Metadata_Encryption_Mapping() {
+	auto& dm = android::dm::DeviceMapper::Instance();
+	std::vector<android::dm::DeviceMapper::DmBlockDevice> devices;
+	if (!dm.GetAvailableDevices(&devices)) {
+		LOGERR("Cannot inspect device-mapper state before Format Data.\n");
+		return false;
+	}
+	for (const auto& device : devices) {
+		if (device.name() != "userdata")
+			continue;
+		if (!dm.DeleteDevice("userdata")) {
+			LOGERR("Cannot remove userdata mapping; Format Data stopped before mkfs.\n");
+			return false;
+		}
+		LOGINFO("Removed userdata metadata-encryption mapping before Format Data.\n");
+	}
+	return true;
+}
